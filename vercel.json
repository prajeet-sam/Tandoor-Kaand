{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/index.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/_not-found.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/__next._full.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/__next._tree.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/__next.__PAGE__.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/_not-found/__next._full.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/_not-found/__next._tree.txt",
      "destination": "/",
      "statusCode": 404
    },
    {
      "source": "/_not-found/__next._not-found/__PAGE__.txt",
      "destination": "/",
      "statusCode": 404
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; media-src 'none'; object-src 'none'; frame-src 'self'; frame-ancestors 'none'; form-action 'none'; base-uri 'self'; worker-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), battery=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}